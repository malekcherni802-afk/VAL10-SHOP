{
  "name": "valio",
  "version": "4.0.0",
  "private": true,
  "description": "VALIO — Luxury Algerian Streetwear monorepo",
  "scripts": {
    "dev:backend":  "cd backend  && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
